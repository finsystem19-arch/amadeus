{
  "name": "amadeus-local-ai-orchestrator",
  "private": true,
  "version": "0.4.3",
  "description": "Amadeus  -  Local AI Orchestrator by Mad Max Systems",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "amadeus:privacy": "node plugins/amadeus/scripts/privacy-scan.mjs plugins/amadeus",
    "amadeus:onboard": "node plugins/amadeus/scripts/onboard.mjs",
    "amadeus:qualify-local": "node scripts/qualify-local-model.mjs",
    "amadeus:migrate-state": "node plugins/amadeus/scripts/migrate-state.mjs",
    "amadeus:self-test": "node plugins/amadeus/scripts/server.mjs --self-test",
    "amadeus:support-preview": "node plugins/amadeus/scripts/support-bundle.mjs",
    "public-safety": "node scripts/public-safety-scan.mjs . && node plugins/amadeus/scripts/privacy-scan.mjs plugins/amadeus",
    "public-safety:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-public-safety-sandbox.mjs | node --input-type=module)",
    "amadeus:install-deps": "node scripts/install-dependencies.mjs",
    "test": "node --test --test-isolation=none --test-concurrency=1 test/amadeus-clean-machine.test.mjs test/amadeus-onboarding.test.mjs test/completion-reporting.test.mjs test/long-haul-closeout.test.mjs test/progress-guard.test.mjs test/structured-decisions.test.mjs test/removed-evaluation-profile.test.mjs test/module-structure.test.mjs test/orchestrator.test.mjs test/worker-environment.test.mjs test/verification-reporting.test.mjs test/verification-build-step.test.mjs test/recovery-seed.test.mjs test/compact-wait.test.mjs test/provider-neutral-routing.test.mjs test/worker-providers.test.mjs test/sandbox-policy-snapshots.test.mjs test/worker-sandbox.test.mjs test/codex-network-default.test.mjs test/provider-flows.test.mjs test/state-backup.test.mjs test/usage-limit.test.mjs test/amadeus-branding.test.mjs test/amadeus-distribution.test.mjs test/amadeus-updates-providers.test.mjs test/windows-ui-automation.test.mjs test/amadeus-public-trust.test.mjs test/deterministic-verifier-discovery.test.mjs test/amadeus-release.test.mjs test/amadeus-state-migration.test.mjs test/amadeus-state-consolidation.test.mjs test/amadeus-runtime-authority.test.mjs test/worker-sandbox-node-entry.test.mjs test/symlinked-entrypoint.test.mjs test/local-model-routing.test.mjs test/posix-workers.test.mjs test/model-catalog-home.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:runtime-authority": "node --test --test-isolation=none test/amadeus-runtime-authority.test.mjs",
    "test:runtime-authority:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-runtime-authority-tests-sandbox.mjs | node --input-type=module)",
    "test:worker-isolation:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-worker-isolation-source-tests-sandbox.mjs | node --input-type=module)",
    "test:clean-machine:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-clean-machine-tests-sandbox.mjs | node --input-type=module)",
    "test:state-migration": "node --test --test-isolation=none test/amadeus-state-migration.test.mjs test/amadeus-state-consolidation.test.mjs",
    "test:state-migration:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-state-migration-tests-sandbox.mjs | node --input-type=module)",
    "test:amadeus": "node plugins/amadeus/scripts/server.mjs --self-test",
    "test:updates-providers": "node --test --test-isolation=none test/amadeus-updates-providers.test.mjs",
    "test:updates-providers:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-updates-providers-tests-sandbox.mjs | node --input-type=module)",
    "test:verifier-discovery:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-deterministic-verifier-discovery-tests-sandbox.mjs | node --input-type=module)",
    "test:excluded-path:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-excluded-path-tests-sandbox.mjs | node --input-type=module)",
    "test:branding:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-branding-tests-sandbox.mjs | node --input-type=module)",
    "amadeus:privacy:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-privacy-scan-sandbox.mjs | node --input-type=module)",
    "amadeus:build": "node scripts/build-agent-package.mjs && node scripts/build-plugin-runtime.mjs && node scripts/build-claude-package.mjs --publish",
    "test:claude-host": "node --test --test-isolation=none test/claude-host-lifecycle.test.mjs test/claude-signed-in-worker.test.mjs test/local-checkpoint-handoff.test.mjs",
    "test:claude-host:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-claude-host-tests-sandbox.mjs | node --input-type=module)",
    "claude:host-preflight": "node scripts/claude-host-lifecycle.mjs preflight",
    "claude:host-preflight:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-claude-host-preflight-sandbox.mjs | node --input-type=module)",
    "claude:host-canary": "node scripts/claude-host-canary.mjs",
    "claude:live-host-canary": "node scripts/claude-live-host-canary.mjs",
    "claude:live-worker-canary": "node scripts/claude-live-worker-canary.mjs",
    "claude:origin-host-canary": "node scripts/claude-origin-host-canary.mjs",
    "codex:sandbox-probe": "node scripts/codex-sandbox-probe.mjs",
    "claude:host-canary:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-claude-host-canary-sandbox.mjs | node --input-type=module)",
    "claude:live-host-canary:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-claude-live-host-canary-sandbox.mjs | node --input-type=module)",
    "checkpoint:handoff:probe": "set NODE_OPTIONS=&& (type scripts\\run-checkpoint-handoff-probe-sandbox.mjs | node --input-type=module)",
    "test:packaged": "node scripts/build-agent-package.mjs --check && node scripts/build-plugin-runtime.mjs --check && node scripts/build-claude-package.mjs --check-published && node --test test/amadeus-release.test.mjs test/agent-package.test.mjs test/claude-static-parity.test.mjs test/claude-package.test.mjs",
    "test:packaged:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-packaged-tests-sandbox.mjs | node --input-type=module)",
    "test:reporting:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-completion-reporting-tests-sandbox.mjs | node --input-type=module)",
    "amadeus:build:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-package-build-sandbox.mjs | node --input-type=module)",
    "workspace-diff-check": "set NODE_OPTIONS=&& (type scripts\\workspace-diff-check.mjs | node --input-type=module)",
    "test:state-consolidation:sandbox": "set NODE_OPTIONS=&& (type scripts\\run-state-consolidation-tests-sandbox.mjs | node --input-type=module)",
    "claude:worker-live-check": "node scripts/claude-worker-live-check.mjs",
    "worker:sandbox-run": "node scripts/worker-sandbox-run.mjs",
    "codex:worker-live-check": "node scripts/codex-worker-live-check.mjs"
  },
  "coordinator": {
    "verify": [
      "workspace-diff-check",
      "test:worker-isolation:sandbox",
      "test:excluded-path:sandbox",
      "test:branding:sandbox",
      "test:updates-providers:sandbox",
      "test:verifier-discovery:sandbox",
      "test:state-migration:sandbox",
      "test:state-consolidation:sandbox",
      "test:runtime-authority:sandbox",
      "test:clean-machine:sandbox",
      "test:packaged:sandbox",
      "test:claude-host:sandbox",
      "public-safety:sandbox"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MadMaxSoftware/amadeus.git"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
